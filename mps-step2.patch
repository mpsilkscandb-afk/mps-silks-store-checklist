+  function listPhotos(subs, dateFrom, dateTo, limit) {
+    var max = limit > 0 ? limit : 200;
+    var all = (subs || []).filter(function (s) {
+      return s && s.photoRef && s.date && s.date >= dateFrom && s.date <= dateTo;
+    }).sort(function (a, b) {
