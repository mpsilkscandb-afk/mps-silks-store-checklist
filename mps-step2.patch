-// ── local drafts (answers only; photos are not persisted) ─────
+// ── draft photos: kept in this browser's IndexedDB until submitted ──
+// (answers go to localStorage; photos are too big for it). Nothing here is
+// ever sent anywhere until the staff member presses Submit.
+var dpDbPromise = null;
+function dpOpen() {
+  if (!dpDbPromise) {
+    dpDbPromise = new Promise(function (resolve) {
+      try {
+        var req = window.indexedDB.open('mps_draft_photos', 1);
+        req.onupgradeneeded = function () { req.result.createObjectStore('photos'); };
+        req.onsuccess = function () { resolve(req.result); };
+        req.onerror = function () { resolve(null); };
+        req.onblocked = function () { resolve(null); };
+      } catch (e) { resolve(null); }
+    });
+  }
+  return dpDbPromise;
+}
+function dpKey(id) { return me.name + '|' + today + '|' + id; }
+function dpPut(id, dataUrl) {
+  dpOpen().then(function (db) {
+    if (!db) return;
+    try { db.transaction('photos', 'readwrite').objectStore('photos').put(dataUrl, dpKey(id)); } catch (e) {}
+  });
+}
+function dpDelete(id) {
+  dpOpen().then(function (db) {
+    if (!db) return;
+    try { db.transaction('photos', 'readwrite').objectStore('photos').delete(dpKey(id)); } catch (e) {}
+  });
+}
+// Returns { taskId: dataUrl } for today; removes this user's older-day leftovers.
+function dpLoadAll() {
+  return dpOpen().then(function (db) {
+    if (!db) return {};
+    return new Promise(function (resolve) {
+      var out = {}, mine = me.name + '|', todayPfx = me.name + '|' + today + '|';
+      try {
+        var store = db.transaction('photos', 'readwrite').objectStore('photos');
+        var req = store.openCursor();
+        req.onsuccess = function () {
+          var cur = req.result;
+          if (!cur) { resolve(out); return; }
+          var k = String(cur.key);
+          if (k.indexOf(todayPfx) === 0) out[k.slice(todayPfx.length)] = cur.value;
+          else if (k.indexOf(mine) === 0) cur.delete();
+          cur.continue();
+        };
+        req.onerror = function () { resolve(out); };
+      } catch (e) { resolve({}); }
+    });
+  });
+}
+function dpClearAll() {
+  dpLoadAll().then(function (m) { Object.keys(m).forEach(dpDelete); });
+}
